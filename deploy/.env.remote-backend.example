# 生图/远程应用节点环境变量示例。
# 使用方法：在生图服务器上把本文件复制为 ".env"，再按注释修改必填项。
# 这个节点只运行 Sub2API 应用，不运行 PostgreSQL/Redis；数据来自主服务器的 PostgreSQL/Redis。

# 监听配置。一般保持默认即可。
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# 必填：主服务器 PostgreSQL 连接信息。
# REMOTE_DATABASE_HOST 填主服务器内网 IP、VPN IP 或数据库内网域名，不建议填公网 IP。
REMOTE_DATABASE_HOST=10.0.0.1
REMOTE_DATABASE_PORT=5432
REMOTE_DATABASE_USER=sub2api
REMOTE_DATABASE_PASSWORD=change_this_to_main_postgres_password
REMOTE_DATABASE_DBNAME=sub2api
REMOTE_DATABASE_SSLMODE=disable

# 可选：当前这个 Sub2API 进程的数据库连接池。
# 注意所有 Sub2API 节点的 DATABASE_MAX_OPEN_CONNS 总和不要超过 PostgreSQL max_connections。
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# 必填：主服务器 Redis 连接信息。
# Redis 保存缓存、调度、并发/锁等运行时状态，生图节点必须和主节点共用同一个 Redis。
REMOTE_REDIS_HOST=10.0.0.1
REMOTE_REDIS_PORT=6379
REMOTE_REDIS_PASSWORD=change_this_to_main_redis_password
REMOTE_REDIS_DB=0
REMOTE_REDIS_ENABLE_TLS=false
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10

# 必填：必须和主服务器 Sub2API 保持一致。
# JWT_SECRET 不一致会导致后台登录态/令牌不一致。
# TOTP_ENCRYPTION_KEY 不一致会导致已配置的 2FA/TOTP 无法正常解密。
JWT_SECRET=change_this_to_the_same_jwt_secret_as_main_node
JWT_EXPIRE_HOUR=24
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0
TOTP_ENCRYPTION_KEY=change_this_to_the_same_totp_key_as_main_node

# 可选：只有共享数据库是空库、第一次初始化时才会用到。
# 如果主服务器已经跑起来并已有数据，这两个通常不会生效。
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# 可选：OAuth 相关密钥。
# 如果主服务器配置了这些值，建议这里也填同样的值；没有使用对应 OAuth 功能可以留空。
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=
GEMINI_QUOTA_POLICY=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
ANTIGRAVITY_USER_AGENT_VERSION=

# 生图节点建议配置：图片流式超时和当前进程的图片并发限制。
# GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS 按生图服务器机器规格和上游账号能力调整。
# overflow_mode=wait 表示并发满时排队等待；如果想超限直接拒绝，可改为 reject。
GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
GATEWAY_IMAGE_CONCURRENCY_ENABLED=true
GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=10
GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=wait
GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=60
GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100

# 安全/网络配置。
# 如果上游地址、代理地址、定价地址或共享资源使用内网 IP/域名，保持 PRIVATE_HOSTS=true。
# 生产环境不建议允许不安全 HTTP，除非你明确在可信内网中使用。
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=

# 可选：用于在线更新、拉取定价数据等访问外网的代理。
UPDATE_PROXY_URL=
